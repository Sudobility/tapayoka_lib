{
  "name": "@sudobility/tapayoka_lib",
  "version": "0.0.60",
  "description": "Business logic library with Zustand stores for Tapayoka",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./derived": {
      "import": "./dist/business/derived/index.js",
      "types": "./dist/business/derived/index.d.ts"
    }
  },
  "publishConfig": {
    "access": "restricted"
  },
  "files": [
    "dist/**/*"
  ],
  "scripts": {
    "build": "bunx tsc -p tsconfig.build.json",
    "build:watch": "bunx tsc --watch",
    "clean": "rm -rf dist",
    "prepublishOnly": "bun run clean && bun run build",
    "test": "vitest run",
    "lint": "bunx eslint src",
    "typecheck": "bunx tsc --noEmit",
    "format": "bunx prettier --write 'src/**/*.ts'"
  },
  "author": "Sudobility",
  "license": "BUSL-1.1",
  "peerDependencies": {
    "@sudobility/tapayoka_client": "^0.0.57",
    "@sudobility/tapayoka_types": "^0.0.51",
    "@sudobility/types": "^1.9.65",
    "@tanstack/react-query": ">=5.0.0",
    "react": ">=18.0.0",
    "zustand": ">=5.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@sudobility/tapayoka_client": "^0.0.57",
    "@sudobility/tapayoka_types": "^0.0.51",
    "@sudobility/types": "^1.9.65",
    "@tanstack/react-query": "^5.90.5",
    "@types/react": "^19.2.2",
    "@typescript-eslint/eslint-plugin": "^8.50.0",
    "@typescript-eslint/parser": "^8.50.0",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "prettier": "^3.7.4",
    "react": "^19.0.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.4",
    "zustand": "^5.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/johnqh/tapayoka_lib.git"
  }
}
