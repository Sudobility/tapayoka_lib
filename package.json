{
  "name": "@sudobility/tapayoka_lib",
  "version": "0.0.67",
  "description": "Business logic library with Zustand stores for Tapayoka",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./derived": {
      "import": "./dist/business/derived/index.js",
      "types": "./dist/business/derived/index.d.ts"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist/**/*"
  ],
  "scripts": {
    "build": "bunx tsc -p tsconfig.build.json",
    "build:watch": "bunx tsc --watch",
    "clean": "rm -rf dist",
    "prepublishOnly": "bun run clean && bun run build",
    "test:unit": "vitest run",
    "lint": "bunx eslint src",
    "typecheck": "bunx tsc --noEmit",
    "format": "bunx prettier --write 'src/**/*.ts'"
  },
  "author": "Sudobility",
  "license": "BUSL-1.1",
  "peerDependencies": {
    "@sudobility/tapayoka_client": "^0.0.64",
    "@sudobility/tapayoka_types": "^0.0.58",
    "@sudobility/types": "^1.9.75",
    "@tanstack/react-query": ">=5.0.0",
    "react": ">=18.0.0",
    "zustand": ">=5.0.0"
  },
  "devDependencies": {
    "@eslint/js": "~9.39.5",
    "@sudobility/tapayoka_client": "^0.0.64",
    "@sudobility/tapayoka_types": "^0.0.58",
    "@sudobility/types": "^1.9.75",
    "@tanstack/react-query": "~5.104.5",
    "@types/react": "~19.3.0",
    "@typescript-eslint/eslint-plugin": "~8.72.0",
    "@typescript-eslint/parser": "~8.72.0",
    "eslint": "~9.39.5",
    "eslint-config-prettier": "~10.1.8",
    "eslint-plugin-prettier": "~5.5.7",
    "prettier": "~3.9.10",
    "react": "~19.3.1",
    "typescript": "~5.9.3",
    "vitest": "~4.1.12",
    "zustand": "~5.0.16"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Sudobility/tapayoka_lib.git"
  }
}
